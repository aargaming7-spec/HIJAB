# Copy file ini menjadi .env, lalu isi dengan kredensial Supabase kamu.
# Ambil dari: Supabase Dashboard -> Settings -> API

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=isi-dengan-anon-public-key

# Midtrans (payment gateway) - CLIENT KEY saja, aman ditaruh di frontend.
# SERVER KEY tidak boleh ada di file ini — itu disimpan di Supabase Edge Function secrets.
VITE_MIDTRANS_CLIENT_KEY=isi-dengan-client-key-midtrans
VITE_MIDTRANS_IS_PRODUCTION=false

# CATATAN:
# - Pakai "anon public" key, JANGAN pakai "service_role" key di sini.
# - File .env TIDAK ikut ter-commit ke git (sudah ada di .gitignore).
# - Untuk deploy ke GitHub Pages, tambahkan kedua value ini sebagai
#   Repository Secrets di GitHub (Settings -> Secrets and variables -> Actions),
#   lalu masukkan ke workflow deploy.yml (lihat README).
